#!/usr/bin/env bash
# hev-tun-helper - privileged companion for SoildTunnel Linux.
#
# Runs as root via pkexec. Starts the hev-socks5-tunnel engine process,
# which creates the soildtunnel0 TUN device, then layers addressing and
# default routes on top of it. Cleans everything up on exit.
#
# Usage:
#   hev-tun-helper --mtu 1500 [--ipv6] [--socks 127.0.0.1:1819]
set -u

MTU=1500
IPV6=0
SOCKS="127.0.0.1:1819"
IFACE="soildtunnel0"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
HEV_BIN="$SELF_DIR/hev-socks5-tunnel"

while [ $# -gt 0 ]; do
	case "$1" in
	--mtu)
		MTU="$2"; shift 2 ;;
	--ipv6)
		IPV6=1; shift ;;
	--socks)
		SOCKS="$2"; shift 2 ;;
	*)
		shift ;;
	esac
done

if [ ! -x "$HEV_BIN" ]; then
	echo "hev binary missing at $HEV_BIN" >&2
	exit 1
fi

HOST="${SOCKS%:*}"
PORT="${SOCKS##*:}"
CFG="$(mktemp /tmp/soildtunnel-hev-XXXXXX.yaml)"

cat > "$CFG" <<EOF
tunnel:
  name: $IFACE
  mtu: $MTU
  ipv4: 10.10.14.1
  ipv6: 'fc00::10:10:14:1'
socks5:
  address: $HOST
  port: $PORT
  udp: 'udp'
misc:
  tcp-read-write-timeout: 300000
  udp-read-write-timeout: 120000
EOF

cleanup() {
	ip route del default dev "$IFACE" metric 50 2>/dev/null
	if [ "$IPV6" = "1" ]; then
		ip -6 route del default dev "$IFACE" metric 50 2>/dev/null
	fi
	pkill -TERM -P "$HEV_PID" 2>/dev/null
	kill "$HEV_PID" 2>/dev/null
	rm -f "$CFG"
}
trap cleanup EXIT INT TERM

"$HEV_BIN" "$CFG" &
HEV_PID=$!

# Wait until the TUN device appears before layering routes on it.
for _ in $(seq 1 50); do
	ip link show "$IFACE" >/dev/null 2>&1 && break
	sleep 0.1
done

ip addr replace 10.10.14.1/30 dev "$IFACE" 2>/dev/null
if [ "$IPV6" = "1" ]; then
	ip -6 addr replace fc00::10:10:14:1/126 dev "$IFACE" 2>/dev/null
fi
ip link set mtu "$MTU" dev "$IFACE" 2>/dev/null
ip link set up dev "$IFACE"
ip route add default dev "$IFACE" metric 50 2>/dev/null
if [ "$IPV6" = "1" ]; then
	ip -6 route add default dev "$IFACE" metric 50 2>/dev/null
fi

wait "$HEV_PID"
